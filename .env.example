# ──────────────────────────────────────────────────────────────
#  WAdesk — environment
#  Leave Supabase blank to run in LOCAL DEMO MODE (file-backed store, simulated WhatsApp).
#  Fill the three Supabase values to switch to the real backend.
# ──────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_NAME=WAdesk
NEXT_PUBLIC_APP_URL=http://localhost:4600

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32+ random chars. Encrypts your Meta access token + app secret at rest.
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Protects /api/cron/dispatch (Vercel Cron sends it as a Bearer token automatically).
CRON_SECRET=

# Meta Graph API version used for all WhatsApp calls.
META_GRAPH_VERSION=v23.0
